{
  "name": "dojo-video-engine",
  "version": "0.0.0",
  "private": true,
  "description": "A deterministic, browser-native video scene engine for apps and coding agents.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "golden:test": "pnpm --filter @dojo-video-engine/golden run golden:test",
    "golden:update": "pnpm --filter @dojo-video-engine/golden run update",
    "presets:generate": "node examples/generate-preset-gallery.mjs",
    "showcase:generate": "node examples/generate-showcase.mjs",
    "resource:smoke": "pnpm --filter @dojo-video-engine/golden run resource:smoke",
    "fuzz:scene": "node scripts/fuzz-scenes.mjs",
    "corpus:check": "node scripts/check-example-corpus.mjs",
    "cross-browser": "pnpm --filter @dojo-video-engine/golden run cross-browser",
    "performance:gate": "pnpm --filter @dojo-video-engine/golden run performance:gate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:contracts:test": "node --test scripts/package-contracts.test.mjs",
    "check:contracts": "pnpm check:contracts:test && node scripts/check-package-contracts.mjs",
    "check:schema": "pnpm --filter @dojo-video-engine/schema check:schema",
    "check:migrations": "node scripts/check-scene-migrations.mjs",
    "check:release": "vitest run scripts/publish-release.test.mjs",
    "check:media-oracle": "vitest run scripts/media-content-oracle.test.mjs",
    "lint": "pnpm check:contracts && node scripts/check-determinism.mjs && pnpm check:schema && pnpm check:migrations && pnpm check:release && pnpm check:media-oracle && pnpm -r lint",
    "format": "prettier --write .",
    "release:fast": "node scripts/release-gate.mjs fast",
    "release:full": "node scripts/release-gate.mjs full",
    "release:pack": "node scripts/pack-release.mjs",
    "verify:clean": "node scripts/verify-clean-machine.mjs",
    "verify:media": "pnpm build && node scripts/verify-media-content.mjs",
    "verify:terminal": "node scripts/verify-terminal-editing.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "nanoid@3": "3.3.18",
      "postcss": "8.5.32"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PansaLegrand/dojo-video-engine.git"
  },
  "homepage": "https://github.com/PansaLegrand/dojo-video-engine#readme",
  "bugs": {
    "url": "https://github.com/PansaLegrand/dojo-video-engine/issues"
  }
}
