{
  "name": "motionforge",
  "version": "0.0.0",
  "private": true,
  "description": "A deterministic, browser-native video scene engine for apps and coding agents.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @motionforge/chat dev",
    "dev:chat": "pnpm --filter @motionforge/chat dev",
    "dev:playground": "pnpm --filter @motionforge/playground dev",
    "golden:test": "pnpm --filter @motionforge/golden run golden:test",
    "golden:update": "pnpm --filter @motionforge/golden run update",
    "presets:generate": "node examples/generate-preset-gallery.mjs",
    "showcase:generate": "node examples/generate-showcase.mjs",
    "resource:smoke": "pnpm --filter @motionforge/golden run resource:smoke",
    "fuzz:scene": "node scripts/fuzz-scenes.mjs",
    "corpus:check": "node scripts/check-example-corpus.mjs",
    "cross-browser": "pnpm --filter @motionforge/golden run cross-browser",
    "performance:gate": "pnpm --filter @motionforge/golden run performance:gate",
    "agent:gate": "pnpm --filter @motionforge/agent-eval test",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:contracts:test": "node --test scripts/package-contracts.test.mjs",
    "check:contracts": "pnpm check:contracts:test && node scripts/check-package-contracts.mjs",
    "check:schema": "pnpm --filter @motionforge/schema check:schema",
    "check:migrations": "node scripts/check-scene-migrations.mjs",
    "lint": "pnpm check:contracts && node scripts/check-determinism.mjs && pnpm check:schema && pnpm check:migrations && pnpm -r lint",
    "format": "prettier --write .",
    "e2e": "pnpm --filter @motionforge/golden run e2e",
    "release:fast": "node scripts/release-gate.mjs fast",
    "release:full": "node scripts/release-gate.mjs full",
    "verify:clean": "node scripts/verify-clean-machine.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
