{
  "name": "@dojo-video-engine/create",
  "version": "1.1.0",
  "description": "Create a starter DojoVideoEngine video project.",
  "keywords": [
    "dojo-video-engine",
    "video",
    "starter",
    "scaffold",
    "create"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PansaLegrand/dojo-video-engine.git",
    "directory": "packages/create-dojo-video-engine"
  },
  "homepage": "https://github.com/PansaLegrand/dojo-video-engine#readme",
  "bugs": "https://github.com/PansaLegrand/dojo-video-engine/issues",
  "type": "module",
  "bin": {
    "create-dojo-video-engine": "./dist/bin/create-dojo-video-engine.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"**/dist/**\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "vitest": "4.1.12"
  }
}
