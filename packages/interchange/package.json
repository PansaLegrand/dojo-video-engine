{
  "name": "@dojo-video-engine/interchange",
  "version": "1.2.0",
  "description": "Bounded provider-neutral timeline, Remotion-host, and static snapshot interchange for DojoVideoEngine.",
  "keywords": [
    "dojo-video-engine",
    "video",
    "interchange",
    "timeline"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PansaLegrand/dojo-video-engine.git",
    "directory": "packages/interchange"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "SAXES_LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"**/dist/**\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dojo-video-engine/schema": "workspace:*",
    "zod": "4.6.7",
    "zod-to-json-schema": "^3.25.2",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "vitest": "4.1.12"
  }
}
