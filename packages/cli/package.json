{
  "name": "@dojo-video-engine/cli",
  "version": "1.2.0",
  "description": "Command-line validation and inspection tools for DojoVideoEngine scene modules.",
  "keywords": [
    "dojo-video-engine",
    "video",
    "cli",
    "validate",
    "scene"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PansaLegrand/dojo-video-engine.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/PansaLegrand/dojo-video-engine#readme",
  "bugs": "https://github.com/PansaLegrand/dojo-video-engine/issues",
  "type": "module",
  "bin": {
    "dojo-video-engine": "./dist/bin/dojo-video-engine.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"**/dist/**\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dojo-video-engine/agent-tools": "workspace:*",
    "@dojo-video-engine/inspection": "workspace:*",
    "@dojo-video-engine/schema": "workspace:*",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "vitest": "4.1.12"
  }
}
