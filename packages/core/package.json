{
  "name": "@dojo-video-engine/core",
  "version": "1.1.2",
  "description": "Scene builder API, keyframe animation evaluator, and layout pass for dojo-video-engine.",
  "keywords": [
    "dojo-video-engine",
    "video",
    "animation",
    "keyframes",
    "layout",
    "scene"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PansaLegrand/dojo-video-engine.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/PansaLegrand/dojo-video-engine#readme",
  "bugs": "https://github.com/PansaLegrand/dojo-video-engine/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY.md",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"**/dist/**\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dojo-video-engine/schema": "workspace:*",
    "bidi-js": "1.0.3"
  },
  "devDependencies": {
    "vitest": "4.1.12"
  }
}
