{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@dojo-video-engine/schema": ["packages/schema/src/index.ts"],
      "@dojo-video-engine/schema/values": ["packages/schema/src/values.ts"],
      "@dojo-video-engine/authoring": ["packages/authoring/src/index.ts"],
      "@dojo-video-engine/cli": ["packages/cli/src/index.ts"],
      "@dojo-video-engine/commands": ["packages/commands/src/index.ts"],
      "@dojo-video-engine/core": ["packages/core/src/index.ts"],
      "@dojo-video-engine/agent-tools": ["packages/agent-tools/src/index.ts"],
      "@dojo-video-engine/extensions": ["packages/extensions/src/index.ts"],
      "@dojo-video-engine/inspection": ["packages/inspection/src/index.ts"],
      "@dojo-video-engine/interchange": ["packages/interchange/src/index.ts"],
      "@dojo-video-engine/layout": ["packages/layout/src/index.ts"],
      "@dojo-video-engine/create": ["packages/create-dojo-video-engine/src/index.ts"],
      "@dojo-video-engine/presets": ["packages/presets/src/index.ts"],
      "@dojo-video-engine/presets/catalog": ["packages/presets/src/catalog.ts"],
      "@dojo-video-engine/presets/intents": ["packages/presets/src/intents.ts"],
      "@dojo-video-engine/presets/macros": ["packages/presets/src/macros.ts"],
      "@dojo-video-engine/showcase": ["packages/showcase/src/index.ts"],
      "@dojo-video-engine/renderer-canvas2d": [
        "packages/renderer-canvas2d/src/index.ts"
      ],
      "@dojo-video-engine/renderer-canvas2d/runtime": [
        "packages/renderer-canvas2d/src/runtime.ts"
      ],
      "@dojo-video-engine/runtime": ["packages/runtime/src/index.ts"],
      "@dojo-video-engine/export": ["packages/export/src/index.ts"],
      "@dojo-video-engine/player": ["packages/player/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  }
}
