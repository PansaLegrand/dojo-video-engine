{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@motionforge/schema": ["packages/schema/src/index.ts"],
      "@motionforge/schema/values": ["packages/schema/src/values.ts"],
      "@motionforge/authoring": ["packages/authoring/src/index.ts"],
      "@motionforge/cli": ["packages/cli/src/index.ts"],
      "@motionforge/commands": ["packages/commands/src/index.ts"],
      "@motionforge/core": ["packages/core/src/index.ts"],
      "@motionforge/agent-tools": ["packages/agent-tools/src/index.ts"],
      "@motionforge/extensions": ["packages/extensions/src/index.ts"],
      "@motionforge/inspection": ["packages/inspection/src/index.ts"],
      "@motionforge/interchange": ["packages/interchange/src/index.ts"],
      "@motionforge/layout": ["packages/layout/src/index.ts"],
      "@motionforge/create": ["packages/create-motionforge/src/index.ts"],
      "@motionforge/presets": ["packages/presets/src/index.ts"],
      "@motionforge/presets/catalog": ["packages/presets/src/catalog.ts"],
      "@motionforge/presets/intents": ["packages/presets/src/intents.ts"],
      "@motionforge/presets/macros": ["packages/presets/src/macros.ts"],
      "@motionforge/showcase": ["packages/showcase/src/index.ts"],
      "@motionforge/renderer-canvas2d": [
        "packages/renderer-canvas2d/src/index.ts"
      ],
      "@motionforge/renderer-canvas2d/runtime": [
        "packages/renderer-canvas2d/src/runtime.ts"
      ],
      "@motionforge/runtime": ["packages/runtime/src/index.ts"],
      "@motionforge/export": ["packages/export/src/index.ts"],
      "@motionforge/player": ["packages/player/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  }
}
